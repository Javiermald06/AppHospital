<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    xmlns:tools="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <!-- Espaciador Superior -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="40dp" />

        <!-- CONTENEDOR DEL LOGO ESTILIZADO ESSALUD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="110dp"
            android:layout_height="110dp"
            app:cardCornerRadius="55dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#0072CE"
            app:strokeWidth="4dp"
            app:strokeColor="#FFFFFF"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Ícono de Cruz Médica / Corazón que simula el Logo de EsSalud -->
                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_add"
                    app:tint="#FFFFFF"
                    tools:ignore="UseAppTint" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TEXTOS DE BIENVENIDA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EsSenatino"
            android:textColor="#0072CE"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="36dp" />

        <!-- BOTÓN: INGRESAR DIRECTAMENTE -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIniciarSesion"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Ingresar"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0072CE"
            app:cornerRadius="16dp"
            app:elevation="4dp"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>